  m_Script: {fileID: 11500000, guid: 8909a7b854c460945b7273a620ed017e, type: 3}
  m_Name: PoI_02_Wen
  m_EditorClassIdentifier: 
  speakerName: Wen
  characterAvatar: {fileID: 21300000, guid: 67fccfb1ac0952b4e83161be2d12d92a, type: 3}
  arrivalPrompt: 'Studied in Christchurch, Wen comes back to the square for the first
    time since he left, discoverin the changes this place has experienced... '
  arrivalButtonText: Meet Wen
  dialogueLines:
  - "I\u2019ve always felt a special connection to this Cathedral, ever since I first
    visited here."
  - Back in 2011, while staying with my homestay host, Susan, as an international
    student, we came here just a week before the earthquake. The Cathedral Square
    was vibrant, and I could hear music coming from inside.
  - We only took a quick photo outside on the West Porch and didn't step in. At the
    time, it just seemed like an ordinary visit, but I never imagined that would
    be my last chance.
  - "I\u2019m revisiting today not only to meet Susan, but also to see how the place
    looks now. It has changed so much since the earthquake that I can hardly remember
    what it used to look like."
  - "Since I never got to step inside back then\u2026 could you please help me discover
    what the Cathedral might have sounded like that day?"
  voiceClips:
  - {fileID: 8300000, guid: e015db3dfa7795a4b91b5761b537b804, type: 3}
  - {fileID: 8300000, guid: e5e19f044a43deb4ea6ba90d2df24e4d, type: 3}
  - {fileID: 8300000, guid: 73bf29b22ccf5434180ccfe23b6ae721, type: 3}
  - {fileID: 8300000, guid: f32063beb96f6244d92f34fbb6d92aa1, type: 3}
  - {fileID: 8300000, guid: 4099b769e5ff04a4286889f28e7349a4, type: 3}
  alignmentPrompt: Open the camera, and you will see a portal window in front of
    you. Please look around and ensure your surrounding is safe.
  alignmentButtonText: Okay
  interactionInstruction: 'Tips: Walk closer to feel how the audio flows in the space.
    Take your time to  observe and listen. '
  interactionButtonText: Got it
  reflectionPrompt: 'Put down the tablet for a second and focus on the Cathedral
    site. You can read the information on the panel, or simply take a moment to observe.

    Ask
    yourself: What has changed in this place?

'
  reflectionButtonText: Continue
