    - target: {fileID: 3634062570540290034, guid: 39210a0dd84cf024989470efd9a33eae, type: 3}
      propertyPath: m_text
      value: Meet me in the Cathedral
      objectReference: {fileID: 0}
    - target: {fileID: 3634062570540290034, guid: 39210a0dd84cf024989470efd9a33eae, type: 3}
      propertyPath: m_fontSize
